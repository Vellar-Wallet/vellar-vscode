{
  "name": "vellar-x402",
  "displayName": "Vellar x402",
  "description": "Add x402 payment gating to an HTTP endpoint in one command.",
  "version": "0.2.2",
  "publisher": "VellarWallet",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vellar-Wallet/vellar-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "stellar",
    "x402",
    "payments",
    "usdc"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vellar-x402.addPayment",
        "title": "Vellar: Add x402 payment to this endpoint"
      },
      {
        "command": "vellar-x402.reopenOnboarding",
        "title": "Vellar: Reopen getting started"
      }
    ],
    "configuration": {
      "title": "Vellar x402",
      "properties": {
        "vellar-x402.payToAddress": {
          "type": "string",
          "default": "",
          "description": "Your Stellar G-address where USDC x402 payments should land."
        },
        "vellar-x402.notifyOnEveryPayment": {
          "type": "boolean",
          "default": false,
          "description": "Show a notification for every incoming payment, in addition to the first-payment and verification notifications shown by default."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vellar-x402",
          "title": "Vellar x402",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "vellar-x402": [
        {
          "type": "webview",
          "id": "vellar-x402.sidebar",
          "name": "Vellar"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "typecheck": "tsc --noEmit -p ./ && tsc --noEmit -p ./scripts",
    "pretest": "npm run compile && npm run typecheck",
    "vscode:prepublish": "npm run package",
    "vsce-package": "npm run package && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@x402/core": "^2.24.0",
    "@x402/stellar": "^2.24.0"
  }
}
